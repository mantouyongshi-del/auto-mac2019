# GEO 农场系统环境变量配置示例
# 复制为 .env 并填写真实值，绝对不要把真实密钥提交到Git

# Dashboard管理后台密码
DASHBOARD_PASSWORD=your-dashboard-password-here

# GEO业务接口API Key（上游调用用）
GEO_API_KEY=your-geo-api-key-here

# 批量任务间隔（秒，最小15，最大25）
TASK_INTERVAL_MIN=15
TASK_INTERVAL_MAX=25

# 连续失败多少次触发自动退避
FAIL_THRESHOLD=2

# 退避间隔（秒）
BACKOFF_INTERVAL=30
